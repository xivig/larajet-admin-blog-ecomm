APP_NAME="Xivig CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --------------------------------------------------------------------------
# Database Configuration (PHP 8.3/8.4 + MySQL 8.x / MariaDB)
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xivig_cms
DB_USERNAME=xivig_user
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# For Local SQLite Development (Fallback):
# DB_CONNECTION=sqlite

# --------------------------------------------------------------------------
# Database Session, Queue & Cache Architecture
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
CACHE_PREFIX=xivig_cache_

# --------------------------------------------------------------------------
# Local Filesystem & Storage
# --------------------------------------------------------------------------
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# --------------------------------------------------------------------------
# Mail Gateway (Transactional & Queued Outbound)
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Redis (Optional high-throughput fallback)
# --------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
